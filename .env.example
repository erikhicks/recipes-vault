# Copy to .env and set the paths for your machine. .env is gitignored.
#
#     copy .env.example .env
#
# A real environment variable of the same name overrides whatever is here, so
# you can do a one-off run without editing this file:
#
#     $env:RECIPE_VAULT = "D:\Somewhere\Else"; py tools\build.py

# The Recipes folder inside the Obsidian vault — the folder holding the recipe
# notes themselves, not the vault root. Required by tools/build.py.
RECIPE_VAULT=C:\Path\To\Vault\Recipes

# Only needed to regenerate assets/icons.svg, which is committed and rarely
# changes. Point at the `outline/SVG` folder of the hand-drawn cooking icon
# pack. Used by tools/make_icons.py.
ICON_SOURCE=C:\Path\To\hand-drawn-cooking-icons\outline\SVG
